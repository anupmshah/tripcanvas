# Server-side only. Never prefix with NEXT_PUBLIC_. Copy to .env and fill in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional. Without it flights fall back to "check on provider" deep links.
DUFFEL_ACCESS_TOKEN=
DATABASE_URL="file:./dev.db"
# Your email or site URL; goes into the Nominatim User-Agent (their policy asks for it; generic example.com values are blocked)
NOMINATIM_CONTACT=
CHAT_RATE_LIMIT_PER_MIN=10
