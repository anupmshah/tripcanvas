# Server-side only. Never prefix with NEXT_PUBLIC_. Copy to .env and fill in.
# Neon Postgres. DATABASE_URL = pooled (-pooler host), DIRECT_URL = direct host. Append schema=tripcanvas so Prisma keeps its own schema.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&schema=tripcanvas"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&schema=tripcanvas"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional. Without it flights fall back to "check on provider" deep links.
DUFFEL_ACCESS_TOKEN=
# Your email or site URL; goes into the Nominatim User-Agent (their policy asks for it; generic example.com values are blocked)
NOMINATIM_CONTACT=
CHAT_RATE_LIMIT_PER_MIN=10
